# Reference for running the API outside Docker (e.g. `dotnet run`).
# ASP.NET Core reads config from environment variables using "__" as the section separator,
# so export these (or set them in appsettings.Development.json / user-secrets) before running.

ConnectionStrings__Default=Host=localhost;Port=5432;Database=assignment_system;Username=postgres;Password=postgres

Jwt__Key=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
Jwt__Issuer=AssignmentSystem
Jwt__Audience=AssignmentSystemClient
Jwt__ExpiryMinutes=60

Cors__AllowedOrigins__0=http://localhost:3000
